{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@shared": ["./app/shared/index.ts"],
      "@shared/*": ["./app/shared/*"],
      "@modules/*": ["./app/modules/*"],
      "@composition/*": ["./app/composition/*"],
      "@bootstrap/*": ["./app/bootstrap/*"],
      "@ui/*": ["./app/ui/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "*.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "docs", "android", "ios", "dist"]
}
