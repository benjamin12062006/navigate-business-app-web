    <span>
      navigate<span class="text-[#78905d]">.</span>
    </span>
  </a>
  <span class="pr-5 text-[9px] tracking-[.16em] text-[#75816c] max-[1050px]:hidden">
    UNA PERSPECTIVA MÁS CLARA
  </span>
  <a
    class="flex items-center gap-[9px] rounded-md border border-[#d5ddcc] px-[13px] py-2.5
