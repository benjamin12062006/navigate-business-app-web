        d="m9 22 5-12 4 8 5-12"
        stroke="#e9f0e2"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M18 6h5v5"
        stroke="#c0d6a5"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
