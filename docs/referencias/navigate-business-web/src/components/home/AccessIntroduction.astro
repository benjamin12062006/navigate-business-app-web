---
import PerspectiveArt from './PerspectiveArt.astro';
---

<div class="w-full max-[760px]:max-w-[470px] max-[760px]:justify-self-center">
  <p class="mb-[23px] flex items-center gap-2.5 text-[9px] font-medium tracking-[.17em] text-[#708160] max-[760px]:mb-[19px]">
    <span class="h-px w-[25px] bg-[#82976c]" aria-hidden="true"></span>
    CLARIDAD ANTES DE ACTUAR
  </p>
  <h1
    class="m-0 text-[clamp(39px,4.7vw,64px)] leading-[1.08] font-medium tracking-[-.055em]
      max-[760px]:text-[clamp(37px,7vw,51px)] max-[420px]:text-[37px]"
  >
    Tu próxima decisión
    <br class="max-[760px]:hidden" /> empieza con
    <br />
    <em class="inline-block font-display text-[1.28em] leading-[1.16] font-normal tracking-[-.04em] text-accent">
      perspectiva.
    </em>
  </h1>
  <p class="mt-[25px] text-[13px] leading-[1.85] text-[#75806c] max-[760px]:mt-[18px] max-[760px]:max-w-[360px]">
    Un lugar para ordenar tus ideas, encontrar contexto
    <br class="max-[1050px]:hidden" />y construir tu propia mirada sobre las
    inversiones.
  </p>
  <PerspectiveArt />
</div>
