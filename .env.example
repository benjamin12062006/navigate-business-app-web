# Valores PUBLICOS de Firebase del frontend actual. Nunca copiar el .env del backend.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=expo-city-bol
EXPO_PUBLIC_FIREBASE_APP_ID=

# La API del frontend actual usa Go en 8085 y /api/v1.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8085/api/v1
EXPO_PUBLIC_ANDROID_API_BASE_URL=http://10.0.2.2:8085/api/v1
EXPO_PUBLIC_IOS_API_BASE_URL=
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=true

# Registrar las apps nativas en el MISMO proyecto Firebase de la web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
